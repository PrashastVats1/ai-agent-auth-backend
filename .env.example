NEON_DATABASE_URL=postgresql://user:password@host/dbname
MONOCLOUD_ISSUER_URL=https://<your-monocloud-domain>
MONOCLOUD_AUDIENCE=https://<your-api-audience>
JWT_SECRET=<random-secret-min-32-chars>
# Comma-separated URLs of your deployed dashboard (localhost:5173 is always allowed)
CORS_ALLOWED_ORIGINS=https://<your-dashboard-domain>
